+	wait()
+	fasthttp.ReleaseRequest(req)
+	if bifrostErr != nil {
+		fasthttp.ReleaseResponse(resp)
+		serverCleanup()
+		t.Fatalf("send failed: %v", bifrostErr)
+	}
+	return resp, func() {
+		fasthttp.ReleaseResponse(resp)
+		serverCleanup()
+	}
+}
