+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, fmt.Sprintf("http://%s/thing", listener.Addr()), bytes.NewReader(requestBody))
+	if err != nil {
+		t.Fatalf("new request: %v", err)
+	}
