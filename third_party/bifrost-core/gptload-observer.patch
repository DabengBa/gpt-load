+	if err := observer.firstCompletionErr(); err != nil {
+		t.Fatalf("expected eof completion, got %v", err)
+	}
+	if got := observer.lastTermination(); got != TerminationEOF {
+		t.Fatalf("expected eof termination, got %q", got)
