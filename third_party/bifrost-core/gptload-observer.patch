+// streamedAttempt bundles the teardown handles of one streamed response so a
+// test can reproduce the production defer order.
+type streamedAttempt struct {
+	resp             *fasthttp.Response
+	reader           io.Reader
+	rawStream        io.Reader
+	releaseGzip      func()
+	stopIdle         func()
+	stopCancellation func()
+}
