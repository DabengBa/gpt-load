{
  "name": "gpt-load-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12.1.0"
  },
  "scripts": {
    "build": "pnpm run type-check && vite build",
    "dev": "vite",
    "docs:build": "node ../.docs/db/scripts/doc-compiler.js build --root ../.docs/db",
    "docs:check": "node ../.docs/db/scripts/doc-compiler.js check --root ../.docs/db",
    "e2e": "PLAYWRIGHT_PORT=$(node -e \"const net=require('node:net');const server=net.createServer();server.listen(0,'127.0.0.1',()=>{console.log(server.address().port);server.close()})\") playwright test --config playwright.config.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0 && node scripts/verify-i18n-icu.mjs && node scripts/verify-theme-build.mjs",
    "test": "node --import ./scripts/register-typescript.mjs --import ./scripts/register-shared-alias.mjs --test \"scripts/*.test.ts\" scripts/register-typescript.test.mjs",
    "test:astryx-routes": "node --import ./scripts/register-typescript.mjs --test scripts/astryx-routes.test.ts",
    "test:channel-contract": "node --import ./scripts/register-typescript.mjs --test scripts/channel-contract.test.ts",
    "test:channel-icon": "node --import ./scripts/register-typescript.mjs --test scripts/channel-icon.test.ts",
    "test:connection-json": "node --import ./scripts/register-typescript.mjs --test scripts/connection-json.test.ts",
    "test:group-detail-route": "node --import ./scripts/register-typescript.mjs --import ./scripts/register-shared-alias.mjs --test scripts/group-detail-route.test.ts",
    "test:header-rules": "node --import ./scripts/register-typescript.mjs --test scripts/header-rules-validation.test.ts",
    "test:import-route": "node --import ./scripts/register-typescript.mjs --import ./scripts/register-shared-alias.mjs --test scripts/import-route.test.ts",
    "test:logs-route": "node --import ./scripts/register-typescript.mjs --import ./scripts/register-shared-alias.mjs --test scripts/logs-route.test.ts",
    "test:monitor-route": "node --import ./scripts/register-typescript.mjs --import ./scripts/register-shared-alias.mjs --test scripts/monitor-route.test.ts",
    "test:safe-redirect": "node --import ./scripts/register-typescript.mjs --import ./scripts/register-shared-alias.mjs --test scripts/safe-redirect.test.ts",
    "test:search-codec": "node --import ./scripts/register-typescript.mjs --test scripts/search-codec.test.ts",
    "test:settings-route": "node --import ./scripts/register-typescript.mjs --import ./scripts/register-shared-alias.mjs --test scripts/settings-route.test.ts",
    "theme:build": "astryx theme build src/frontends/astryx/theme/gptload.theme.ts -o src/frontends/astryx/theme/gptload.theme.css",
    "theme:check": "node scripts/verify-theme-build.mjs",
    "type-check": "tsc --noEmit -p tsconfig.astryx.json && tsc --noEmit -p tsconfig.node.json",
    "verify:astryx-i18n": "node scripts/verify-astryx-i18n.mjs",
    "verify:group-collection": "node scripts/verify-group-collection.mjs",
    "verify:fingerprint-contract": "node scripts/verify-fingerprint-contract.mjs",
    "verify:health-projection": "node scripts/verify-health-projection.mjs",
    "verify:i18n-icu": "node scripts/verify-i18n-icu.mjs",
    "verify:log-format": "node scripts/verify-log-format.mjs",
    "verify:model-test-alias": "node scripts/verify-model-test-alias.mjs",
    "verify:reasoning-contract": "node scripts/verify-reasoning-contract.mjs",
    "verify:request-log-affinity": "node scripts/verify-request-log-affinity.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.4",
    "@astryxdesign/theme-neutral": "0.7.4",
    "@internationalized/date": "3.12.4",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/query-core": "5.105.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "12.1.6"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.4",
    "@babel/core": "8.0.9",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.3"
  },
  "browserslist": [
    "chrome >= 125"
  ],
  "overrides": {
    "brace-expansion@5.0.8": "5.0.9",
    "minimatch@9.0.9": "10.2.5",
    "nanoid@3.3.16": "3.3.18",
    "postcss@8.5.21": "8.5.23"
  }
}
