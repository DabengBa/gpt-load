{
  "name": "gpt-load-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type-check && vite build",
    "lint": "eslint . --max-warnings=0 && node scripts/verify-i18n-icu.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "verify:group-collection": "node scripts/verify-group-collection.mjs",
    "verify:health-projection": "node scripts/verify-health-projection.mjs",
    "verify:request-log-affinity": "node scripts/verify-request-log-affinity.mjs",
    "docs:check": "node ../.docs/db/scripts/doc-compiler.js check --root ../.docs/db",
    "docs:build": "node ../.docs/db/scripts/doc-compiler.js build --root ../.docs/db",
    "test:connection-json": "node --experimental-strip-types --test scripts/connection-json.test.ts",
    "test:channel-contract": "node --experimental-strip-types --test scripts/channel-contract.test.ts",
    "e2e:request-log-affinity": "PLAYWRIGHT_PORT=$(node -e \"const net=require('node:net');const server=net.createServer();server.listen(0,'127.0.0.1',()=>{console.log(server.address().port);server.close()})\") playwright test --config playwright.config.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.astryx.json && tsc --noEmit -p tsconfig.node.json",
    "verify:i18n-icu": "node scripts/verify-i18n-icu.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.2",
    "@astryxdesign/theme-neutral": "0.6.2",
    "@internationalized/date": "3.12.4",
    "@lucide/vue": "1.46.0",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/query-core": "5.103.1",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/vue-query": "5.103.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.0",
    "reka-ui": "2.10.4",
    "vue": "3.5.42",
    "vue-i18n": "11.4.12",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.2",
    "@babel/core": "8.0.5",
    "@formatjs/icu-messageformat-parser": "3.5.19",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-typescript": "14.9.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-vue": "10.11.0",
    "prettier": "3.9.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vue-tsc": "3.3.11"
  },
  "browserslist": [
    "chrome >= 125"
  ],
  "overrides": {
    "brace-expansion@5.0.8": "5.0.9",
    "minimatch@9.0.9": "10.2.5",
    "nanoid@3.3.16": "3.3.18",
    "postcss@8.5.21": "8.5.23"
  }
}
