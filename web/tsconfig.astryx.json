{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@app/*": ["./src/frontends/astryx/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/frontends/astryx/**/*.ts", "src/frontends/astryx/**/*.tsx", "src/shared/**/*.ts"]
}
